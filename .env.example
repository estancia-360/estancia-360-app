# Server
NODE_ENV=development
PORT=3000
API_PREFIX=api
DOMAIN_FRONTEND=*

# Database (PostgreSQL)
DB_TYPE=postgres
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_password
DB_NAME=your_database
DB_LOGS=false

# Seed
SEED_ROOT_EMAIL=root@app.com
SEED_ROOT_PASSWORD=Root1234!
# Auth (JWT) — sin refresh token, un único access token
# Generate secrets with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
ACTIVE_JWT=true
JWT_SECRET=your_jwt_secret_here
JWT_TIME_EXPIRE=15m
# Mailer (set MAILER_TRANSPORT to 'smtp' or 'api')
MAILER_TRANSPORT=smtp

# SMTP (used when MAILER_TRANSPORT=smtp)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your_email@example.com
SMTP_PASS=your_password
SMTP_FROM="My App" <noreply@example.com>

# API e.g. Resend (used when MAILER_TRANSPORT=api)
# MAILER_API_URL=https://api.resend.com/emails
# MAILER_API_KEY=your_api_key
# MAILER_FROM=noreply@yourdomain.com
